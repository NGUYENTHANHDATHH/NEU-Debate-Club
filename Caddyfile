{$DOMAIN} {
	encode zstd gzip
	# context-path của backend đã là /api nên không cắt path
	handle /api/* {
		reverse_proxy backend:8080
	}
	# Ảnh CMS trong MinIO, bucket "media" (bucket = path nên không cắt path)
	handle /media/* {
		header X-Content-Type-Options nosniff
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

# Một tên miền duy nhất cho SEO: www → tên miền gốc
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
