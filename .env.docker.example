# Copy to .env only if you do not already have one.
# Existing volumes require their original database name, user, and password.
POSTGRES_DB=neu_debate_club
POSTGRES_USER=ndc_user
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Generate a random value as described in DOCKER.md.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=604800000
SPRING_PROFILES_ACTIVE=default

# Google login requires your OAuth web client ID and an allowed account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=.ndc.neu@gmail.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Browser-facing URL, baked into the frontend at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# Leave unset to use GOOGLE_CLIENT_ID for the frontend as well.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
