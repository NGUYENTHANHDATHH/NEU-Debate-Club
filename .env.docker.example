# Copy to .env only if you do not already have one.
# Existing volumes require their original database name, user, and password.
POSTGRES_DB=neu_debate_club
POSTGRES_USER=ndc_user
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Generate a random value as described in DOCKER.md.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=604800000
SPRING_PROFILES_ACTIVE=default

# Google login requires your OAuth web client ID and an allowed account.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY= 
VAPID_SUBJECT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Browser-facing URL, baked into the frontend at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# Domain công khai của website (SEO: sitemap, robots, Open Graph). Production: https://DOMAIN
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave unset to use GOOGLE_CLIENT_ID for the frontend as well.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# PayOS: QR thanh toán khoản "chưa thu" của thành viên. Lấy ở my.payos.vn → Kênh thanh toán.
# Để trống = tắt thanh toán online. Webhook: https://<domain>/api/public/payos/webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Website mà PayOS đưa thành viên quay về sau khi thanh toán.
FRONTEND_URL=http://localhost:3000

# MinIO lưu ảnh CMS (bucket "media", phục vụ qua /media/*). Mật khẩu tối thiểu 8 ký tự.
# Không đổi sau khi volume MinIO đã có dữ liệu (MinIO chỉ đọc lúc tạo lần đầu).
MINIO_ROOT_USER=ndc_minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# ---- Production (docker-compose.prod.yml + Caddy, xem DEPLOY.md) ----
# Bỏ comment và sửa các dòng tương ứng ở trên khi chạy trên server.
# DOMAIN=neudebateclub.id.vn
# SPRING_PROFILES_ACTIVE=prod
# CORS_ALLOWED_ORIGINS=https://neudebateclub.id.vn
# FRONTEND_URL=https://neudebateclub.id.vn
# NEXT_PUBLIC_API_BASE_URL=https://neudebateclub.id.vn/api
# NEXT_PUBLIC_SITE_URL=https://neudebateclub.id.vn
# VAPID_SUBJECT=mailto:<email-that-cua-clb>
